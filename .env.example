# Copy to .env at the repo root. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://activity:activity@localhost:5432/activity
REDIS_URL=redis://localhost:6379
AWS_REGION=ap-south-1

# Local SQS (ElasticMQ). In AWS leave SQS_ENDPOINT unset.
SQS_ENDPOINT=http://localhost:9324
SQS_JOBS_QUEUE_URL=http://localhost:9324/000000000000/activity-jobs

# Auth. Locally the dev provider sends no SMS: every code is DEV_OTP_CODE.
# In AWS: AUTH_PROVIDER=cognito plus COGNITO_USER_POOL_ID / COGNITO_CLIENT_ID / COGNITO_CLIENT_SECRET.
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=local-dev-secret-change-me-at-least-32-chars
DEV_OTP_CODE=000000

# Photos. Locally an S3 emulator (docker compose) stands in for S3 + CloudFront.
PHOTOS_BUCKET=activity-photos
S3_ENDPOINT=http://localhost:9090
PHOTOS_PUBLIC_BASE_URL=http://localhost:9090/activity-photos
# Workers: `none` auto-approves photos and selfies locally. AWS uses Rekognition.
MODERATION_PROVIDER=none

# Search. Locally OpenSearch runs in docker compose with security off; in AWS the
# API and workers sign requests with their task roles (OPENSEARCH_AUTH=aws).
# SEARCH_PROVIDER=postgres serves the feed from PostGIS only (no OpenSearch needed).
SEARCH_PROVIDER=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_AUTH=none
OPENSEARCH_REPLICAS=0

# Push. `log` prints notifications in the worker logs; AWS uses SNS (PUSH_PROVIDER=sns
# with SNS_ANDROID_APP_ARN / SNS_IOS_APP_ARN from Terraform).
PUSH_PROVIDER=log
